<?xml version="1.0" encoding="utf-8"?>
<!--
    Moo Launcher's mark: a front-facing cow head, flat white, no stroke, no gradient.

    A familiar silhouette rather than an abstract mark, because the icon has to survive a
    small render - an abstract two-element shape reads as anonymous at that size where a
    recognisable outline does not. The ears are part of the outer contour rather than shapes
    laid over the head, so the whole silhouette is one closed path; eyes and nostrils are
    separate subpaths and become real holes under evenOdd, which keeps the mark transparent
    where it should be and lets the same path serve as the monochrome layer.

    108x108 is the adaptive-icon canvas. Everything sits inside the central 72x72 safe zone
    (18..90 on both axes), so no launcher mask can clip an ear or the muzzle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Scaled to 0.88 about the centre. The path is drawn to the 72x72 safe zone exactly, so
        at 1.0 the ear tips sit ON the circular mask's edge and look cramped rather than
        composed. This keeps a margin inside the crop on every mask shape.
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.88"
        android:scaleY="0.88">
        <path
            android:fillColor="#FFFFFF"
