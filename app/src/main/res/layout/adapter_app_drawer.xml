<?xml version="1.0" encoding="utf-8"?>
<!--
    No animateLayoutChanges: the row's holder cleared the LayoutTransitions it created on every
    construction, so they were built only to be thrown away.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!--
        minHeight rather than taller padding: a row is padding plus one line of text at whatever
        size the user picked, and at 420dpi and below that came to 46.5dp - close enough to look
        right and still under the 48dp minimum. A floor holds at every text size; padding would
        have to be retuned for each one.
    -->
    <TextView
        android:id="@+id/appTitle"
        style="@style/TextLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:minHeight="48dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="@dimen/app_padding_vertical"
        android:text="@string/app" />

    <TextView
        android:id="@+id/badgeState"
        style="@style/TextSmallBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/otherProfileIndicator"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:src="@drawable/ic_rounded"
        app:tint="?attr/primaryColor" />

    <!--
        The long-press menu and the rename field are built on first use, not with every row: only
        the three views above are ever visible until someone long-presses, and a drawer open
        builds a screenful of rows from scratch. The stubs' size and margins become the inflated
        layouts' own, so they cover the row exactly as the inline versions did.
    -->
    <ViewStub
        android:id="@+id/appMenuStub"
        android:inflatedId="@+id/appHideLayout"
        android:layout="@layout/adapter_app_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginVertical="1dp" />

    <ViewStub
        android:id="@+id/renameStub"
        android:inflatedId="@+id/renameLayout"
        android:layout="@layout/adapter_app_rename"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
