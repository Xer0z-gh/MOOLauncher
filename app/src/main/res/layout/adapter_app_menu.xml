<?xml version="1.0" encoding="utf-8"?>
<!-- A drawer row's long-press action menu. Inflated from a ViewStub on the first long-press of
     that row: every row used to carry these seven views, GONE, built on every drawer open. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appHideLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryShadeDarkColor"
    android:clickable="false"
    android:focusable="false"
    android:importantForAccessibility="no"
    android:gravity="end|center_vertical">

    <TextView
        android:id="@+id/appDelete"
        style="@style/TextSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:drawablePadding="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:minHeight="48dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        android:text="@string/delete"
        android:textSize="12sp"
        app:drawableTopCompat="@drawable/ic_delete" />

    <TextView
        android:id="@+id/appRename"
        android:minHeight="48dp"
        android:paddingVertical="12dp"
        style="@style/TextSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:drawablePadding="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:text="@string/rename"
        android:textSize="12sp"
        app:drawableTopCompat="@drawable/ic_rename" />

    <TextView
        android:id="@+id/appHide"
        android:minHeight="48dp"
        android:paddingVertical="12dp"
        style="@style/TextSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:drawablePadding="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:text="@string/hide"
        android:textSize="12sp"
        app:drawableTopCompat="@drawable/ic_hide" />

    <TextView
        android:id="@+id/appInfo"
        android:minHeight="48dp"
        android:paddingVertical="12dp"
        style="@style/TextSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:drawablePadding="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:text="@string/info"
        android:textSize="12sp"
        app:drawableTopCompat="@drawable/ic_info" />

    <TextView android:id="@+id/appCategory" style="@style/TextSmall"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:minHeight="48dp"
        android:paddingVertical="12dp" android:paddingHorizontal="4dp"
        android:gravity="center" android:maxLines="1" android:ellipsize="end"
        android:text="@string/category_action" android:textSize="12sp"
        app:drawableTopCompat="@drawable/ic_categories" />
    <TextView
        android:id="@+id/appMenuClose"
        android:minHeight="48dp"
        android:paddingVertical="12dp"
        style="@style/TextSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:drawablePadding="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:text="@string/close"
        android:textSize="12sp"
        app:drawableTopCompat="@drawable/ic_close" />

</LinearLayout>
