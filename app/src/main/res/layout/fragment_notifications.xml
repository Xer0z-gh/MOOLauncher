<?xml version="1.0" encoding="utf-8"?>
<!--
    The notification panel.

    Structure follows the one thing this screen is for: read what is in the shade, then act on
    one or clear it. So the list is the screen, the header is one line, and everything else is
    absent. No cards, no section chrome, no empty hero - a launcher screen that costs a swipe
    has to repay it in the first half second.

    The content column is capped to panel_max_width in code rather than here: on a tablet, an
    unfolded foldable, or a phone in landscape, a full-bleed list drags the eye across the whole
    screen to read a 30-character message. Below that width the cap never applies.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/panelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryColorInverseTrans90"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- This bound column is width-capped independently from the full-screen inset root. -->
    <LinearLayout
        android:id="@+id/content"
        tools:ignore="UselessParent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:paddingHorizontal="16dp">
            <TextView android:id="@+id/panelHome" style="@style/TextSmall" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp"
                android:gravity="center" android:text="@string/return_home" android:background="?attr/selectableItemBackground" />
            <TextView android:id="@+id/panelTitle" style="@style/TextMedium" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:padding="8dp"
                android:text="@string/notifications" />
            <TextView android:id="@+id/panelCustomize" style="@style/TextSmall" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp"
                android:gravity="center" android:text="@string/panel_edit" android:contentDescription="@string/customize_notifications"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>
        <!-- The playing app stays visible while the notification list scrolls. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pinnedMedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:visibility="gone"
            tools:listitem="@layout/adapter_notification" />
        <LinearLayout android:id="@+id/filterControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <LinearLayout android:id="@+id/filterBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/panel_padding_horizontal">

            <TextView android:id="@+id/focusToggle" style="@style/TextSmall"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minHeight="48dp" android:gravity="center_vertical"
                android:text="@string/panel_focus" android:background="?attr/selectableItemBackground" />
            <TextView
                android:id="@+id/filterToggle"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_weight="0"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="48dp"
                android:minWidth="96dp"
                android:paddingHorizontal="12dp"
                android:text="@string/notifications_filtered"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/allToggle"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:layout_weight="0"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="48dp"
                android:minWidth="96dp"
                android:text="@string/notifications_all"
                android:textAllCaps="false" />

        </LinearLayout>

        <TextView android:id="@+id/filterHelp" style="@style/TextSmall"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="24dp" android:paddingVertical="4dp" android:textSize="12sp"
            android:text="@string/panel_filter_help" />
        </LinearLayout>
        <!--
            Empty and error share one TextView because they are the same shape - a sentence
            explaining why the list is blank - and the only difference is whether tapping it
            does something. Two views would drift apart in styling for no gain.
        -->
        <TextView
            android:id="@+id/emptyState"
            style="@style/TextSmall"
            android:accessibilityLiveRegion="polite"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="32dp"
            android:visibility="gone"
            tools:text="Nothing in the shade"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fadingEdgeLength="24dp"
            android:paddingBottom="24dp"
            android:requiresFadingEdge="vertical"
            tools:listitem="@layout/adapter_notification" />

        <TextView
            android:id="@+id/clearAll"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/panel_clear"
            android:textAllCaps="false"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
