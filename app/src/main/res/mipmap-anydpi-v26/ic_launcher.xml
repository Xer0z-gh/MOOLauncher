<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
        Themed icons (Android 13+) tint a single-colour layer to the wallpaper palette, so the
        mark has to be the same path with no baked white - which it is, because the eyes and
        nostrils are real holes rather than background-coloured fills.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
