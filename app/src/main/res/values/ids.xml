<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Remembers the colour a view's focus ring was last built for. applyFocusOutline assigns a
        new StateListDrawable, and View.setForeground short-circuits only on reference identity -
        so without this tag a fresh object is installed on every call and setForeground's trailing
        requestLayout() runs every time. Driven from an OnGlobalLayoutListener that turned into a
        measure/layout loop at the display refresh rate.
    -->
    <item name="focus_ring_color" type="id" />
    <item name="dialog_list_tint" type="id" />
    <!-- Settings' Align to bottom switch value, a row built in code (SettingsFragment). -->
    <item name="alignmentBottom" type="id" />
    <!--
        Settings sliders, built in code. A stable id lets Android put focus back on the slider when
        a keyboard or TalkBack step recreates the page (Text size, Text weight).
    -->
    <item name="sliderAppIconSize" type="id" />
    <item name="sliderHomeSpacing" type="id" />
    <item name="sliderTextSize" type="id" />
    <item name="sliderTextWeight" type="id" />
    <item name="sliderAlignment" type="id" />
</resources>
